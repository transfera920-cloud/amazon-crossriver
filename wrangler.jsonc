{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amazon-crossriver",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "amazon-hike.com/chapter19",
      "zone_name": "amazon-hike.com"
    },
    {
      "pattern": "amazon-hike.com/chapter19/*",
      "zone_name": "amazon-hike.com"
    }
  ]
}
